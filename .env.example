# ============================================================
# Diagnóstico Cris. Tributario: variables de entorno
# Copia este archivo a .env.local y completa los valores.
# Sin Supabase la app corre en "modo demo" (no persiste datos).
# ============================================================

# --- URL pública del sitio (links del correo y del CRM) ---
# Producción: el subdominio final, por ejemplo https://diagnostico.cristributario.cl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (necesario para guardar diagnósticos) ---
# supabase.com → proyecto nuevo → SQL Editor: correr supabase/migrations/001_diagnosticos.sql
# Settings → API: Project URL y service_role key. NUNCA en una variable NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Botón "Quiero agendar mi asesoría" ---
# DÉJALA VACÍA salvo que quieras otro destino: por defecto lleva a la agenda
# propia (https://cristributario.cl/diagnostico), donde la persona elige
# día y hora sin cierre manual. A esa URL (o a cualquier otra: otro calendario,
# un link de pago) se le añaden ?diagnostico=<id>&codigo=<8 chars>&fase=<A1..C3>.
# Los enlaces de WhatsApp ya no se soportan: si queda uno guardado, se ignora.
NEXT_PUBLIC_URL_ASESORIA=

# --- Resend (envío del diagnóstico por correo) ---
# resend.com → verificar el dominio del remitente (SPF y DKIM en su DNS) → API key.
RESEND_API_KEY=
# Debe ser una dirección de un dominio verificado en Resend.
EMAIL_FROM="Cris. Tributario <diagnostico@cristributario.cl>"

# --- GoHighLevel (CRM: contacto + etiquetas para los workflows) ---
# Subcuenta de Cris → Settings → Private Integrations → token con permisos de contactos.
GHL_API_TOKEN=
# Subcuenta → Settings → Business Profile → Location ID
GHL_LOCATION_ID=
# Opcional: ids de campos personalizados de contacto para guardar el resultado.
GHL_CAMPO_FASE=
GHL_CAMPO_SCORE=
GHL_CAMPO_OFERTA=
GHL_CAMPO_PROBLEMA=
GHL_CAMPO_URL_RESULTADO=
# Campos que lee el bot de WhatsApp (carpeta "Diagnóstico" del contacto).
GHL_CAMPO_CODIGO=
GHL_CAMPO_ETAPA=
GHL_CAMPO_URL_AGENDA=
GHL_CAMPO_CONTEXTO=
# Campos de la oportunidad (carpeta "Diagnóstico" en la ficha de la oportunidad).
GHL_CAMPO_OPP_CODIGO=
GHL_CAMPO_OPP_ETAPA=
GHL_CAMPO_OPP_SCORE=
GHL_CAMPO_OPP_PROBLEMA=
GHL_CAMPO_OPP_INTENCION=
GHL_CAMPO_OPP_OFERTA=
GHL_CAMPO_OPP_URL_RESULTADO=
GHL_CAMPO_OPP_CONTEXTO=
# Pipeline del diagnóstico: sin estas tres no se crea oportunidad.
GHL_PIPELINE_DIAGNOSTICO=
# Etapa al completar el diagnóstico, y al escribir por WhatsApp.
GHL_ETAPA_COMPLETADO=
GHL_ETAPA_WHATSAPP=
# Secreto del webhook /api/ghl/vincular (el workflow de GHL lo manda en
# ?secreto=). Sin él, el endpoint queda deshabilitado.
GHL_WEBHOOK_SECRET=

# --- Consulta por WhatsApp (botón secundario del resultado) ---
# Con código de país. También se edita en /admin/configuracion. Vacío = sin botón.
WHATSAPP_NUMERO=

# --- PostHog (analítica de eventos del quiz) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Meta: Pixel + API de Conversiones ---
# Events Manager → dataset de Cris. El mismo ID va en las dos variables.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
# Events Manager → Configuración → API de conversiones → Generar token
META_CAPI_TOKEN=
# Solo para pruebas en el probador de eventos. QUITAR en producción.
META_TEST_EVENT_CODE=
META_API_VERSION=

# --- Cron de barrido de abandonos (Vercel lo manda como Bearer) ---
CRON_SECRET=

# --- Panel /admin ---
ADMIN_PASSWORD=cambia-esta-password

# --- Badge "texto provisional" sobre textos placeholder ---
NEXT_PUBLIC_SHOW_PLACEHOLDER_BADGE=false
